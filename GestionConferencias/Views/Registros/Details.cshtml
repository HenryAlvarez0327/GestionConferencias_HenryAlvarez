@model GestionConferencias.Models.Registro

@{
    ViewData["Title"] = "Detalle del Registro";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Detalle del Registro</h2>
        <small class="text-muted">Información de la inscripción</small>
    </div>

    <div class="d-flex gap-2 align-items-center">
        <a asp-action="Edit"
           asp-route-id="@Model.RegistroId"
           class="btn btn-warning btn-sm px-4 shadow-sm">
            Editar
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary btn-sm px-4 shadow-sm">
            Volver
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <div class="fw-semibold">Registro #@Model.RegistroId</div>
        <span class="badge bg-secondary">Detalle</span>
    </div>

    <div class="card-body">

        <div class="row g-3">

            
            <div class="col-md-6">
                <div class="p-3 border rounded bg-light">
                    <small class="text-muted d-block">Fecha de registro</small>
                    <div class="fw-semibold fs-5">
                        @(Model.FechaRegistro?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="p-3 border rounded bg-light">
                    <small class="text-muted d-block">Asistente</small>

                    @if (Model.Asistente != null)
                    {
                        <div class="fw-semibold fs-5">
                            @Model.Asistente.Nombre @Model.Asistente.Apellido
                        </div>
                        <div>
                            <a href="mailto:@Model.Asistente.Email">@Model.Asistente.Email</a>
                        </div>
                        <div class="text-muted">
                            Tel: @(string.IsNullOrWhiteSpace(Model.Asistente.Telefono) ? "—" : Model.Asistente.Telefono)
                        </div>
                    }
                    else
                    {
                        <div class="fw-semibold fs-5">—</div>
                    }
                </div>
            </div>

       
            <div class="col-md-12">
                <div class="p-3 border rounded bg-light">
                    <small class="text-muted d-block">Conferencia</small>

                    @if (Model.Conferencia != null)
                    {
                        <div class="fw-semibold fs-5">@Model.Conferencia.Nombre</div>
                        <div class="text-muted">
                            @Model.Conferencia.Fecha.ToString("dd/MM/yyyy HH:mm")
                            | @Model.Conferencia.Ubicacion
                        </div>
                        <div class="mt-2">
                            @Model.Conferencia.Descripcion
                        </div>

                        <div class="mt-3">
                            <a asp-controller="Conferencias"
                               asp-action="Details"
                               asp-route-id="@Model.Conferencia.ConferenciaId"
                               class="btn btn-outline-primary btn-sm px-4 shadow-sm">
                                Ver conferencia
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="fw-semibold fs-5">—</div>
                    }
                </div>
            </div>

        </div>

        <hr class="my-4" />

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Delete"
               asp-route-id="@Model.RegistroId"
               class="btn btn-danger btn-sm px-4 shadow-sm">
                Eliminar
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary btn-sm px-4 shadow-sm">
                Volver
            </a>
        </div>

    </div>
</div>
