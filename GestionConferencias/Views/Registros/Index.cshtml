@model IEnumerable<GestionConferencias.Models.Registro>

@{
    ViewData["Title"] = "Registros";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div class="w-75">
        <h2 class="mb-0">Registros</h2>
        <small class="text-muted">Listado de asistentes registrados a conferencias</small>

        <form asp-action="Index" method="get" class="d-flex gap-2 mt-3">
            <input type="text"
                   id="buscadorRegistros"
                   name="buscar"
                   value="@ViewData["Buscar"]"
                   class="form-control"
                   placeholder="Buscar por asistente o conferencia (nombre, email, ubicación, descripción)..." />

            <button type="submit" class="btn btn-primary">
                Buscar
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Limpiar
            </a>
        </form>
    </div>

    <div>
        <a asp-action="Create" class="btn btn-primary">
            + Nuevo Registro
        </a>
    </div>

</div>

<div class="card shadow-sm">
    <div class="card-body">

        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Fecha Registro</th>
                    <th>Asistente</th>
                    <th>Conferencia</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @(item.FechaRegistro.HasValue? item.FechaRegistro.Value.ToString("dd/MM/yyyy HH:mm") : "")
                        </td>

                        <td>
                            @if (item.Asistente != null)
                            {
                                <div class="fw-semibold">@item.Asistente.Nombre @item.Asistente.Apellido</div>
                                <small class="text-muted">@item.Asistente.Email</small>
                            }
                        </td>

                        <td>
                            @if (item.Conferencia != null)
                            {
                                <div class="fw-semibold">@item.Conferencia.Nombre</div>
                                <small class="text-muted">@item.Conferencia.Ubicacion</small>
                            }
                        </td>

                        <td class="text-end">
                            <a asp-action="Edit"
                               asp-route-id="@item.RegistroId"
                               class="btn btn-sm btn-warning">
                                Editar
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.RegistroId"
                               class="btn btn-sm btn-info text-white">
                                Ver
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.RegistroId"
                               class="btn btn-sm btn-danger">
                                Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>

<script>
    document.getElementById("buscadorRegistros").addEventListener("keyup", function () {

        let texto = this.value.toLowerCase();
        let filas = document.querySelectorAll("tbody tr");

        filas.forEach(function (fila) {

            let contenido = fila.innerText.toLowerCase();

            if (contenido.includes(texto)) {
                fila.style.display = "";
            } else {
                fila.style.display = "none";
            }
        });

    });
</script>
