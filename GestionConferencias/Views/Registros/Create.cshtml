@model GestionConferencias.Models.Registro

@{
    ViewData["Title"] = "Nuevo Registro";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool conferenciaFija = ViewBag.ConferenciaFija != null && (bool)ViewBag.ConferenciaFija;
    int conferenciaIdFija = ViewBag.ConferenciaIdFija != null ? (int)ViewBag.ConferenciaIdFija : 0;
    string conferenciaNombreFija = ViewBag.ConferenciaNombreFija != null ? (string)ViewBag.ConferenciaNombreFija : "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Nuevo Registro</h2>
        <small class="text-muted">Registrar asistente a una conferencia</small>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            @if (conferenciaFija)
            {
                <input type="hidden" asp-for="ConferenciaId" value="@conferenciaIdFija" />

                <div class="mb-3">
                    <label class="form-label">Conferencia</label>
                    <input type="text" class="form-control" value="@conferenciaNombreFija" readonly />
                    <small class="text-muted">Esta conferencia ya está seleccionada.</small>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label asp-for="ConferenciaId" class="form-label"></label>
                    <select asp-for="ConferenciaId" class="form-select" asp-items="ViewBag.ConferenciaId"></select>
                    <span asp-validation-for="ConferenciaId" class="text-danger"></span>
                </div>
            }

            <div class="mb-3">
                <label asp-for="AsistenteId" class="form-label"></label>
                <select asp-for="AsistenteId" class="form-select" asp-items="ViewBag.AsistenteId"></select>
                <span asp-validation-for="AsistenteId" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar Registro</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
