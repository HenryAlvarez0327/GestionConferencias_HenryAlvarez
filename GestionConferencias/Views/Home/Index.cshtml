@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-4">

    <div class="card shadow-lg border-0 mb-4">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <h1 class="display-5 fw-bold mb-2">Gestión de Conferencias</h1>
                    <p class="text-muted fs-5 mb-4">
                        Administra <b>asistentes</b>, <b>conferencias</b> y <b>registros</b> de forma rápida y ordenada.
                    </p>

                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Conferencias" asp-action="Index" class="btn btn-primary btn-lg">
                            Ver Conferencias
                        </a>
                        <a asp-controller="Asistentes" asp-action="Index" class="btn btn-outline-primary btn-lg">
                            Ver Asistentes
                        </a>
                        <a asp-controller="Registros" asp-action="Index" class="btn btn-outline-dark btn-lg">
                            Ver Registros
                        </a>
                    </div>

                    <div class="mt-3 text-muted">
                        Tip: entra a una conferencia y usa <b>“+ Registrar asistente”</b> para inscribir personas.
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="p-4 rounded-4 bg-light border">
                        <h5 class="fw-semibold mb-3">Acciones rápidas</h5>
                        <div class="d-grid gap-2">
                            <a asp-controller="Conferencias" asp-action="Create" class="btn btn-success">
                                + Nueva Conferencia
                            </a>
                            <a asp-controller="Asistentes" asp-action="Create" class="btn btn-success">
                                + Nuevo Asistente
                            </a>
                            <a asp-controller="Registros" asp-action="Create" class="btn btn-success">
                                + Nuevo Registro
                            </a>
                        </div>

                        <hr class="my-4" />

                        <small class="text-muted d-block">
                            Mantén los datos actualizados para que el listado y los detalles se vean completos.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-semibold">Asistentes</h5>
                    <p class="text-muted mb-3">Crea, edita, busca y valida información de asistentes.</p>
                    <a asp-controller="Asistentes" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        Ir a Asistentes
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-semibold">Conferencias</h5>
                    <p class="text-muted mb-3">Gestiona conferencias y revisa asistentes inscritos.</p>
                    <a asp-controller="Conferencias" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        Ir a Conferencias
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-semibold">Registros</h5>
                    <p class="text-muted mb-3">Controla las inscripciones entre asistentes y conferencias.</p>
                    <a asp-controller="Registros" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        Ir a Registros
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
