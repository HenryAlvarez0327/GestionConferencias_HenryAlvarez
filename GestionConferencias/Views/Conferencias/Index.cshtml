@model IEnumerable<GestionConferencias.Models.Conferencia>

@{
    ViewData["Title"] = "Conferencias";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div class="w-75">
        <h2 class="mb-0">Conferencias</h2>
        <small class="text-muted">Listado de conferencias registradas</small>

        <form asp-action="Index" method="get" class="d-flex gap-2 mt-3">
            <input type="text"
                   id="buscador"
                   name="buscar"
                   value="@ViewData["Buscar"]"
                   class="form-control"
                   placeholder="Buscar por nombre, ubicación o descripción..." />

            <button class="btn btn-primary">Buscar</button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Limpiar
            </a>
        </form>
    </div>

    <div>
        <a asp-action="Create" class="btn btn-primary">
            + Nueva Conferencia
        </a>
    </div>

</div>

<div class="card shadow-sm">
    <div class="card-body">

        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Fecha</th>
                    <th>Ubicación</th>
                    <th>Descripción</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Ubicacion</td>
                        <td>@item.Descripcion</td>

                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.ConferenciaId"
                               class="btn btn-sm btn-warning">Editar</a>

                            <a asp-action="Details" asp-route-id="@item.ConferenciaId"
                               class="btn btn-sm btn-info text-white">Ver</a>

                            <a asp-action="Delete" asp-route-id="@item.ConferenciaId"
                               class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

<script>
    document.getElementById("buscador")
        .addEventListener("keyup", function () {

            let texto = this.value.toLowerCase();
            let filas = document.querySelectorAll("tbody tr");

            filas.forEach(fila => {
                fila.style.display =
                    fila.innerText.toLowerCase().includes(texto)
                        ? ""
                        : "none";
            });
        });
</script>
