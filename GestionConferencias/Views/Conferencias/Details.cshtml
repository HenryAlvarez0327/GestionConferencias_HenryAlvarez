@model GestionConferencias.Models.Conferencia

@{
    ViewData["Title"] = "Detalle de Conferencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Detalle de Conferencia</h2>
        <small class="text-muted">Información registrada</small>
    </div>

    <div class="d-flex gap-2 align-items-center">
        <a asp-action="Edit"
           asp-route-id="@Model.ConferenciaId"
           class="btn btn-warning btn-sm px-4 shadow-sm">
            Editar
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary btn-sm px-4 shadow-sm">
            Volver
        </a>
    </div>
</div>



<div class="card shadow-sm mb-4">
    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-6">
                <strong>Nombre:</strong> @Model.Nombre
            </div>

            <div class="col-md-6">
                <strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
            </div>

            <div class="col-md-6">
                <strong>Ubicación:</strong> @Model.Ubicacion
            </div>

            <div class="col-md-6">
                <strong>Descripción:</strong> @Model.Descripcion
            </div>

        </div>

    </div>
</div>



<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Asistentes inscritos</h4>

    <a asp-controller="Registros"
       asp-action="Create"
       asp-route-conferenciaId="@Model.ConferenciaId"
       class="btn btn-primary">
        + Registrar asistente
    </a>

</div>

<div class="card shadow-sm">
    <div class="card-body">

        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Fecha registro</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Registros != null && Model.Registros.Any())
                {
                    foreach (var r in Model.Registros.OrderByDescending(x => x.FechaRegistro))
                    {
                        <tr>
                            <td>@(r.Asistente?.Nombre ?? "—")</td>
                            <td>@(r.Asistente?.Apellido ?? "—")</td>
                            <td>@(r.Asistente?.Email ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(r.Asistente?.Telefono) ? "—" : r.Asistente.Telefono)</td>
                            <td>@(r.FechaRegistro?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>

                            <td class="text-end">
                                <form asp-controller="Registros"
                                      asp-action="Quitar"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="registroId" value="@r.RegistroId" />
                                    <input type="hidden" name="conferenciaId" value="@Model.ConferenciaId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-danger px-3 shadow-sm"
                                            onclick="return confirm('¿Quitar a este asistente de la conferencia?');">
                                        Quitar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">
                            No existen asistentes registrados en esta conferencia.
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>
